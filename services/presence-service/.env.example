PORT=3002
DATABASE_URL=postgresql://puddle:puddle@localhost:5432/puddle
# Supply the same HS256 key, issuer and audience used by your token issuer.
# No auth issuer exists in Phase 1. Blank secret intentionally prevents startup.
JWT_SECRET=
JWT_ISSUER=puddle
JWT_AUDIENCE=puddle-presence
# Exactly one replica until shared membership/capacity and Redis pub/sub exist.
